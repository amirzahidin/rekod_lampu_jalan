<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
             x:Class="RekodLampuJalan.Views.MapsEdit"
             Title="MapsEdit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
 </Grid.RowDefinitions>
        <StackLayout Grid.Row="0">
        <SearchBar x:Name="SearchBox"
                   Placeholder="Search location..."
                   SearchButtonPressed="OnSearchButtonPressed" TextColor="Black"/>
       
        </StackLayout>
        <maps:Map x:Name="map" VerticalOptions="FillAndExpand" MyLocationEnabled="False" Grid.Row="1">
            <maps:Map.GestureRecognizers>
                <DropGestureRecognizer AllowDrop="True" Drop="OnDrop">

                </DropGestureRecognizer>
            </maps:Map.GestureRecognizers>
        </maps:Map>
        <Label x:Name="AddFlyCableLable" IsVisible="False" Text="sini" 
               HorizontalOptions="Center" VerticalOptions="Start" Margin="10" 
               BackgroundColor="#66000000" TextColor="White" Padding="2" Grid.Row="1"/>
        <Button Clicked="logoutClicked" Grid.Row="1" HeightRequest="5" Text="Log out" VerticalOptions="Start" HorizontalOptions="Start" Margin="10"></Button>
        <ImageButton Source="currentlocation.png"
                 Clicked="OnCurrentLocationClicked"
                 WidthRequest="40"
                 HeightRequest="40"
                 BackgroundColor="White"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Grid.Row="1" Margin="10" CornerRadius="5" BorderWidth="1" BorderColor="Blue"/>
        <!-- Button Panel on the Left -->
        <StackLayout Orientation="Vertical"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Padding="10"
             Spacing="30" Grid.Row="1">
            <!-- spacing between inner stacklayouts -->

            <!-- First Stack: Icon Buttons -->
            <StackLayout Orientation="Vertical"
                 BackgroundColor="#66000000"
                 Spacing="15"
                 Padding="8" x:Name="stacklayoutAddIconTools">
                <!-- Icon Button 1 -->
                <Image Source="doublearm.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent">
                    <Image.GestureRecognizers>
                        <DragGestureRecognizer DragStarting="OnDragStarting" />
                        <DropGestureRecognizer DragOver="OnDragOver" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- Icon Button 2 -->
                <Image Source="singlearm.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent">
                    <Image.GestureRecognizers>
                        <DragGestureRecognizer DragStarting="OnDragStarting" />
                        <DropGestureRecognizer DragOver="OnDragOver" />
                    </Image.GestureRecognizers>
                </Image>

                <!-- Icon Button 3 -->
                <Image Source="feeder.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent">
                    <Image.GestureRecognizers>
                        <DragGestureRecognizer DragStarting="OnDragStarting" />
                        <DropGestureRecognizer DragOver="OnDragOver" />
                    </Image.GestureRecognizers>
                </Image>
            </StackLayout>

            <!-- Second Stack: FlyCable + Switch -->
            <StackLayout Orientation="Vertical"
                 BackgroundColor="#66000000"
                 Padding="0"
                 Spacing="0">
                <Image Source="flycable.png" WidthRequest="30" HeightRequest="30" BackgroundColor="Transparent" />
                <Switch x:Name="MySwitch" Toggled="MySwitch_Toggled" Margin="0"/>
            </StackLayout>
        </StackLayout>
    </Grid>
</ContentPage>