<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IsFirstTimeProjectOpen>False</IsFirstTimeProjectOpen>
    <ActiveDebugFramework>net9.0-android</ActiveDebugFramework>
    <ActiveDebugProfile>Pixel 6a - API 34 (Android 14.0 - API 34)</ActiveDebugProfile>
    <SelectedPlatformGroup>Emulator</SelectedPlatformGroup>
    <DefaultDevice>pixel_6a_-_api_34</DefaultDevice>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)'=='iOS'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <PlatformTarget>arm64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <MauiXaml Update="PopUp\AlamatEdit.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\ClickPinViewPopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\FeederViewPopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\FlyCablePopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\ImagePopUpFromFile.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\LoginPopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\NewFeederPillarPopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="PopUp\NewPinPopUp.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="Views\MapsEdit.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="Views\MapsView.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="Views\SplashScreen.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
    <MauiXaml Update="Views\SummaryPage.xaml">
      <SubType>Designer</SubType>
    </MauiXaml>
  </ItemGroup>
  <ItemGroup>
    <None Update="App.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="AppShell.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="MainPage.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="Platforms\Windows\App.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="Platforms\Windows\Package.appxmanifest">
      <SubType>Designer</SubType>
    </None>
    <None Update="Resources\Styles\Colors.xaml">
      <SubType>Designer</SubType>
    </None>
    <None Update="Resources\Styles\Styles.xaml">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
</Project>