<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RekodLampuJalan.PopUp.AlamatEdit"
               Size="420,430"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">
    <ScrollView>
        <Border StrokeThickness="1"
            Stroke="#E0E0E0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 16"
            Padding="20"
            Margin="10">
            <Grid>
                
            
            <VerticalStackLayout Spacing="10">

                <Label x:Name="Jenis"
                   Text="Alamat"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" TextColor="Black"/>

             
                <!-- Start of Grid Form -->
                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                        <Label Text="Nama Jalan" Grid.Row="0" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="0" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                    <Picker Grid.Row="0" Grid.Column="2"
                        x:Name="Jalan"
                        Title="Pilih Nama Jalan"
                        ItemsSource="{Binding namaJalanList}"
                        SelectedItem="{Binding alamat.nama_jalan}" TextColor="Black"/>

                        <Label Grid.Row="1" Text="Bandar" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="1" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                    <Picker Grid.Row="1" Grid.Column="2" x:Name="Bandar"
                        Title="Pilih Bandar"
                        ItemsSource="{Binding bandarList}"
                        SelectedItem="{Binding alamat.bandar}" TextColor="Black"/>

                        <Label Grid.Row="2" Text="Poskod" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="2" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                    <Picker Grid.Row="2" Grid.Column="2" x:Name="Poskod"
                        Title="Pilih Poskod"
                        ItemsSource="{Binding poskodList}"
                        SelectedItem="{Binding alamat.poskod}" TextColor="Black"/>

                        <Label Grid.Row="3" Text="Daerah" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="3" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                    <Picker Grid.Row="3" Grid.Column="2" x:Name="Daerah"
                        Title="Pilih Daerah"
                        ItemsSource="{Binding daerahList}"
                        SelectedItem="{Binding alamat.daerah}" TextColor="Black"/>

                    <!-- Jenis Tiang -->
                        <Label Grid.Row="4" Text="Negeri" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="4" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                    <Picker Grid.Row="4" Grid.Column="2" x:Name="Negeri"
                        Title="Pilih Negeri"
                        ItemsSource="{Binding negeriList}"
                        SelectedItem="{Binding alamat.negeri}" TextColor="Black"/>
                </Grid>
                <Grid>
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <!-- Save Button -->
                        <Button Text="Simpan"
     Clicked="OnSaveClicked"
     BackgroundColor="#4CAF50"
     TextColor="White"
     CornerRadius="10"
     FontAttributes="Bold"
     HeightRequest="45"
     WidthRequest="100"
     Margin="0,10,0,0"/>
                        <Button Text="Cancel"
     Clicked="OnCancelClicked"
     BackgroundColor="#9E9E9E"
     TextColor="White"
     CornerRadius="10"
     FontAttributes="Bold"
     HeightRequest="45"
     WidthRequest="100"
     Margin="10,10,0,0"/>
                    </HorizontalStackLayout>
                </Grid>

            
            </VerticalStackLayout>
                <Grid 
           
            BackgroundColor="#80000000"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False">
                    <!-- This blocks interaction -->

                    <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                Color="White" 
                WidthRequest="50"
                HeightRequest="50"/>
                </Grid>
            </Grid>
        </Border>
    </ScrollView>
</toolkit:Popup>