                     Title="Pilih panjang"
                     ItemsSource="{Binding DropDownItems.Panjang_Lengan_Lampu}"
                     ItemDisplayBinding="{Binding Item, Converter={StaticResource LengthConverter}}"
                     SelectedItem="{Binding dropDownSelectedItem.Panjang_Lengan_Lampu}" TextColor="Black"/>-->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="2">

                            <!-- Entry -->

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="1" Text="m" VerticalOptions="Center" TextColor="Black"></Label>
                                <Entry x:Name="CustomPickerEntryPanjang_Lengan_Lampu" Keyboard="Numeric"
               Placeholder="Pilih Panjang Lengan Lampu"
