<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:common="clr-namespace:RekodLampuJalan.Utils"
               x:Class="RekodLampuJalan.PopUp.NewPinPopUp"
               Size="420,800"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="False">

    <toolkit:Popup.Resources>
        <ResourceDictionary>
            <common:LengthToStringConverter x:Key="LengthConverter"/>
        </ResourceDictionary>
    </toolkit:Popup.Resources>

    <ScrollView>
        <Grid>
            <Border StrokeThickness="1"
         Stroke="#E0E0E0"
         BackgroundColor="White"
         StrokeShape="RoundRectangle 16"
         Padding="20"
         Margin="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="bordertapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">

                    <Label x:Name="Jenis"
                Text="{Binding JenisItem}"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center" TextColor="Black"/>

                    <VerticalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Label Text="{Binding latittudeText}" FontSize="14" TextColor="Black"/>
                            <Label Text="{Binding longitudeText}" FontSize="14" TextColor="Black"/>
                        </HorizontalStackLayout>
                        <Label Text="{Binding address1Text}" FontSize="14" HorizontalOptions="Center" TextColor="Black"/>
                        <Label Text="{Binding address2Text}" FontSize="14" HorizontalOptions="Center" TextColor="Black"/>
                        <Label Text="{Binding address3Text}" FontSize="14" HorizontalOptions="Center" TextColor="Black"/>
                        <Button Text="Ubah Alamat"
 
  BackgroundColor="#007AFF"
  TextColor="White"
  CornerRadius="10"
  FontAttributes="Bold"
  HeightRequest="45"
  WidthRequest="100"
  Margin="0,10,0,0" Command="{Binding OnUbahaAlamatClicked}"/>
                    </VerticalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="Gambar Penuh Tiang Lampu:"
        FontSize="14"
        VerticalOptions="Center" TextColor="Black"/>
                        <Button ImageSource="attachment_icon.png"
         Command="{Binding OnAttachmentImageClicked}"
         CommandParameter="jenis_item"
         WidthRequest="30"
         HeightRequest="30"
         BackgroundColor="Transparent"
         Margin="5,0,0,0"/>
                    </HorizontalStackLayout>
                    <!-- Start of Grid Form -->
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Repeated UI Block (for each field): -->
                        <!-- Example for Jenis Lampu -->
   
                        <Label Text="Jenis Lampu"  VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="0" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="2">
                            
                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntryJenis_Lampu"
               Placeholder="Pilih Jenis Lampu"
               TextChanged="OnEntryTextChangedJenis_Lampu"
               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Jenis_Lampu}" TextColor="Black">
                                <Entry.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTappedJenis_Lampu"></TapGestureRecognizer>
                                </Entry.GestureRecognizers>
                            </Entry>

                            <CollectionView x:Name="SuggestionListJenis_Lampu" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedJenis_Lampu"
ItemsSource="{Binding DropDownItems.Jenis_Lampu}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
                                    <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="4"/>
                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->
                            

                        </VerticalStackLayout>

                        <!--<Picker Grid.Row="0" Grid.Column="2"
                     x:Name="JenisLampu"
                     Title="Pilih jenis lampu"
                     ItemsSource="{Binding DropDownItems.Jenis_Lampu}"
                     ItemDisplayBinding="{Binding Item}"
                     SelectedItem="{Binding dropDownSelectedItem.Jenis_Lampu}" TextColor="Black"/>-->
                        <Button Grid.Row="0" Grid.Column="3"
                     ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}"
                     CommandParameter="jenis_lampu"
                     BackgroundColor="Transparent"
                     WidthRequest="30"
                     HeightRequest="30" />

                        <!-- Copy and increment Grid.Row for each additional field -->
                        <!-- Jenama Lampu -->
                        <Label Grid.Row="1" Text="Jenama Lampu" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="1" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <!--<Picker Grid.Row="1" Grid.Column="2" x:Name="JenamaLampu"
                     Title="Pilih jenama"
                     ItemsSource="{Binding DropDownItems.Jenama_Lampu}"
                     ItemDisplayBinding="{Binding Item}"
                     SelectedItem="{Binding dropDownSelectedItem.Jenama_Lampu}" TextColor="Black"/>-->
