                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntryJenama_Lampu"
               Placeholder="Pilih Jenama Lampu"
               TextChanged="OnEntryTextChangedJenama_Lampu"
               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Jenama_Lampu}" TextColor="Black">
                                <Entry.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTappedJenama_Lampu"></TapGestureRecognizer>
                                </Entry.GestureRecognizers>
                            </Entry>

                            <CollectionView x:Name="SuggestionListJenama_Lampu" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedJenama_Lampu"
ItemsSource="{Binding DropDownItems.Jenama_Lampu}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
                                    <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="4"/>
                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->


                        </VerticalStackLayout>
                        <Button Grid.Row="1" Grid.Column="3" ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}" CommandParameter="jenama_lampu"
                     BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30" />

                        <!-- Continue other fields similarly -->
