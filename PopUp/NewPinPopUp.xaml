                                    </Entry.GestureRecognizers>
                                </Entry>
                            </Grid>
                            <CollectionView x:Name="SuggestionListTinggi_Tiang" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedTinggi_Tiang"
ItemsSource="{Binding DropDownItems.Tinggi_Tiang}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
                                    <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="4"/>
                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->


                        </VerticalStackLayout>
                        <Button Grid.Row="3" Grid.Column="3" ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}" CommandParameter="tinggi_tiang"
                     BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30"/>

                        <!-- Jenis Tiang -->
                        <Label Grid.Row="4" Text="Jenis Tiang" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="4" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <!--<Picker Grid.Row="4" Grid.Column="2" x:Name="JenisTiang"
                     Title="Pilih jenis tiang"
                     ItemsSource="{Binding DropDownItems.Jenis_Tiang}"
                     ItemDisplayBinding="{Binding Item}"
                     SelectedItem="{Binding dropDownSelectedItem.Jenis_Tiang}"  TextColor="Black"/>-->
                        <VerticalStackLayout Grid.Row="4" Grid.Column="2">

                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntryJenis_Tiang"
               Placeholder="Pilih Jenis Tiang"
               TextChanged="OnEntryTextChangedJenis_Tiang"
               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Jenis_Tiang}" TextColor="Black">
                                <Entry.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTappedJenis_Tiang"></TapGestureRecognizer>
                                </Entry.GestureRecognizers>
                            </Entry>

                            <CollectionView x:Name="SuggestionListJenis_Tiang" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedJenis_Tiang"
ItemsSource="{Binding DropDownItems.Jenis_Tiang}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
                                    <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="4"/>
                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->


                        </VerticalStackLayout>
                        <Button Grid.Row="4" Grid.Column="3" ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}" CommandParameter="jenis_tiang"
                     BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30"/>

                        <!-- Material Tiang -->
                        <Label Grid.Row="5" Text="Material Tiang" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="5" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <!--<Picker Grid.Row="5" Grid.Column="2" x:Name="MaterialTiang"
                     Title="Pilih material"
                     ItemsSource="{Binding DropDownItems.Material_Tiang}"
                     ItemDisplayBinding="{Binding Item}"
                     SelectedItem="{Binding dropDownSelectedItem.Material_Tiang}" TextColor="Black"/>-->
                        <VerticalStackLayout Grid.Row="5" Grid.Column="2">

                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntryMaterial_Tiang"
               Placeholder="Pilih Material Tiang"
               TextChanged="OnEntryTextChangedMaterial_Tiang"
               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Material_Tiang}" TextColor="Black">
                                <Entry.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTappedMaterial_Tiang"></TapGestureRecognizer>
                                </Entry.GestureRecognizers>
                            </Entry>

                            <CollectionView x:Name="SuggestionListMaterial_Tiang" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedMaterial_Tiang"
ItemsSource="{Binding DropDownItems.Material_Tiang}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
                                    <Shadow Brush="Black" Opacity="0.2" Offset="0,2" Radius="4"/>
                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->


                        </VerticalStackLayout>
                        <Button Grid.Row="5" Grid.Column="3" ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}" CommandParameter="material_tiang"
                     BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30"/>

                        <!-- Jenama Tiang -->
                        <Label Grid.Row="6" Text="Jenama Tiang" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="6" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <!--<Picker Grid.Row="6" Grid.Column="2" x:Name="JenamaTiang"
                     Title="Pilih jenama"
                     ItemsSource="{Binding DropDownItems.Jenama_Tiang}"
                     ItemDisplayBinding="{Binding Item}"
                     SelectedItem="{Binding dropDownSelectedItem.Jenama_Tiang}" TextColor="Black"/>-->
                        <VerticalStackLayout Grid.Row="6" Grid.Column="2">

                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntryJenama_Tiang"
               Placeholder="Pilih Jenama Tiang"
               TextChanged="OnEntryTextChangedJenama_Tiang"
               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Jenama_Tiang}" TextColor="Black">
                                <Entry.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEntryTappedJenama_Tiang"></TapGestureRecognizer>
                                </Entry.GestureRecognizers>
                            </Entry>

                            <CollectionView x:Name="SuggestionListJenama_Tiang" 
IsVisible="False"
