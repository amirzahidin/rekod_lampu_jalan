               AbsoluteLayout.LayoutBounds="0,0,1,40"
               AbsoluteLayout.LayoutFlags="WidthProportional" Text="{Binding dropDownStringItem.Panjang_Lengan_Lampu}" TextColor="Black">
                                    <Entry.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEntryTappedPanjang_Lengan_Lampu"></TapGestureRecognizer>
                                    </Entry.GestureRecognizers>
                                </Entry>
                                
