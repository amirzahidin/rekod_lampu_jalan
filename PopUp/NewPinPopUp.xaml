                        <Label Text=":" Grid.Row="9" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Editor Grid.Row="9" Grid.Column="2" x:Name="Komen" Text="{Binding mapPin.komen}" Placeholder="Komen" TextColor="Black"/>
                    </Grid>
                    <Grid>
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <!-- Save Button -->
                            <Button Text="Simpan"
  Clicked="OnSaveClicked"
  BackgroundColor="#4CAF50"
  TextColor="White"
  CornerRadius="10"
  FontAttributes="Bold"
  HeightRequest="45"
  WidthRequest="100"
  Margin="0,10,0,0"/>
                            <Button Text="Cancel"
  Clicked="OnCancelClicked"
  BackgroundColor="#9E9E9E"
  TextColor="White"
  CornerRadius="10"
  FontAttributes="Bold"
  HeightRequest="45"
  WidthRequest="100"
  Margin="10,10,0,0"/>
                            <Button Text="Delete" IsVisible="{Binding IsUpdate}"
  Clicked="OnDeleteClicked"
  BackgroundColor="#F44336"
  TextColor="White"
  CornerRadius="10"
  FontAttributes="Bold"
  HeightRequest="45"
  WidthRequest="100"
  Margin="10,10,0,0"/>
                        </HorizontalStackLayout>
                    </Grid>


