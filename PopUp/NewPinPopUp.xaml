                        <VerticalStackLayout Grid.Row="8" Grid.Column="2">

                            <!-- Entry -->


                            <Entry x:Name="CustomPickerEntrySaiz_Pintu_Penyelenggaraan"
               Placeholder="Pilih Saiz Pintu Penyelenggaraan"
