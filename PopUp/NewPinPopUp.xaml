                                </CollectionView.Shadow>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding Item}" Padding="10" TextColor="Black"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Floating Suggestion -->


                        </VerticalStackLayout>
                        <Button Grid.Row="2" Grid.Column="3" ImageSource="attachment_icon.png"
                     Command="{Binding OnAttachmentImageClicked}" CommandParameter="panjang_lengan_lampu"
                     BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30"/>

                        <!-- Tinggi Tiang -->
                        <Label Grid.Row="3" Text="Tinggi Tiang" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <Label Text=":" Grid.Row="3" Grid.Column="1" VerticalOptions="Center" FontSize="14" TextColor="Black"/>
                        <!--<Picker Grid.Row="3" Grid.Column="2" x:Name="TinggiTiang"
                     Title="Pilih tinggi"
                     ItemsSource="{Binding DropDownItems.Tinggi_Tiang}"
                     ItemDisplayBinding="{Binding Item, Converter={StaticResource LengthConverter}}"
                     SelectedItem="{Binding dropDownSelectedItem.Tinggi_Tiang}"  TextColor="Black"/>-->
                        <VerticalStackLayout Grid.Row="3" Grid.Column="2">

                            <!-- Entry -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
