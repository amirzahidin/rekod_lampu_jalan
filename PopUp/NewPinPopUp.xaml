                            <CollectionView x:Name="SuggestionListPanjang_Lengan_Lampu" 
IsVisible="False"
SelectionMode="Single"
SelectionChanged="OnSuggestionSelectedPanjang_Lengan_Lampu"
                                    
ItemsSource="{Binding DropDownItems.Panjang_Lengan_Lampu}"
BackgroundColor="White"
HeightRequest="120"
AbsoluteLayout.LayoutBounds="0,40,1,120"
AbsoluteLayout.LayoutFlags="WidthProportional">
                                <CollectionView.Shadow>
