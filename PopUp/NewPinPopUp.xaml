            </Border>
            <Grid  
           
            BackgroundColor="#80000000"
            IsVisible="{Binding IsBusy}"
            InputTransparent="False">
                <!-- This blocks interaction -->

                <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                HorizontalOptions="Center" 
                VerticalOptions="Center"
                Color="White" 
                WidthRequest="50"
                HeightRequest="50"/>
            </Grid>
        </Grid>
       
    </ScrollView>
