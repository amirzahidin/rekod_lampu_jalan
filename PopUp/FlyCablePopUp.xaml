<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RekodLampuJalan.PopUp.FlyCablePopUp"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Size="420,350"    
           Color="Transparent"
           CanBeDismissedByTappingOutsideOfPopup="False">
    <ScrollView>
        <Border StrokeThickness="1"
        Stroke="#E0E0E0"
        BackgroundColor="White"
        StrokeShape="RoundRectangle 16"
        Padding="20"
        Margin="10">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Header -->
                <Label x:Name="Jenis" Text="Fly Cable" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" TextColor="Black"/>
                <!-- Data Entry Section -->
                <Grid ColumnSpacing="10" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Jarak Cable -->
                    <Label Grid.Row="0" Text="Jarak Cable " FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="0" Text=":" Grid.Column="1" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="0" Grid.Column="2" x:Name="jarakCable" TextColor="Black"/>

                    <Label Grid.Row="1" Text="Start Lattitude " FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="1" Text=":" Grid.Column="1" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="1" Grid.Column="2" x:Name="startLat" TextColor="Black"/>

                    <Label Grid.Row="2" Text="Start Longitude " FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="2" Text=":" Grid.Column="1" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="2" Grid.Column="2" x:Name="startLong" TextColor="Black"/>

                    <Label Grid.Row="3" Text="End Lattitude " FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="3" Text=":" Grid.Column="1" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="3" Grid.Column="2" x:Name="endLat" TextColor="Black"/>

                    <Label Grid.Row="4" Text="End Longitude " FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="4" Text=":" Grid.Column="1" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="Black"/>
                    <Label Grid.Row="4" Grid.Column="2" x:Name="EndLong" TextColor="Black"/>
                </Grid>
                <Grid>
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Button x:Name="DeleteButton" Text="Delete"
 Clicked="OnDeleteClicked"
 BackgroundColor="Red"
 TextColor="White"
 CornerRadius="10"
 FontAttributes="Bold"
 HeightRequest="45"
 WidthRequest="100"
 Margin="10,10,0,0"
 />
                        <Button Text="Close"
 Clicked="OnCloseClicked"
 BackgroundColor="#9E9E9E"
 TextColor="White"
 CornerRadius="10"
 FontAttributes="Bold"
 HeightRequest="45"
 WidthRequest="100"
 Margin="10,10,0,0"/>


                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</toolkit:Popup>