<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="RekodLampuJalan.PopUp.ImagePopUpFromFile"
               
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">
    <ScrollView>
        <Grid>
            <Border StrokeThickness="1"
            Stroke="#E0E0E0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 16"
            Padding="20"
            Margin="10">
                <VerticalStackLayout Padding="10" Spacing="15" BackgroundColor="White">

                    <!-- Top Bar with Title and Close -->
                    <Grid>

                        <Label Text="Muat Naik Gambar"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#333"
               VerticalOptions="Center"
               HorizontalOptions="Center" />
                    </Grid>
                    <!-- Action Buttons -->
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" x:Name="uploadButton">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Button Text="📁"
                    BackgroundColor="#E8F0FE"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    FontSize="24"
                    ToolTipProperties.Text="Pilih Dari Fail"
                    Clicked="OnPickFileClicked"/>
                            <Label Text="Fail" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Button Text="📷"
                    BackgroundColor="#E8F0FE"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    FontSize="24"
                    ToolTipProperties.Text="Ambil Gambar"
                    Clicked="OnTakePhotoClicked"/>
                            <Label Text="Kamera" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Attachment Preview -->
                    <Label
           FontAttributes="Bold"
           FontSize="16"
           HorizontalOptions="Center"
           TextColor="#555"
           x:Name="tittleName"/>

                    <Border Stroke="#DDD" StrokeThickness="1" BackgroundColor="#F9F9F9" StrokeShape="RoundRectangle 10" x:Name="PreviewImageBorder">
                        <Image x:Name="PreviewImage"
               Aspect="AspectFit"
               HeightRequest="300"
               WidthRequest="300"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
                    </Border>
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Button Text="Save"
    BackgroundColor="#4CAF50"
    TextColor="White"
    FontSize="16"
    WidthRequest="100"
    HeightRequest="40"
    CornerRadius="20"
    FontAttributes="Bold"
    ToolTipProperties.Text="Cancel"
    Clicked="OnSaveClicked"
    HorizontalOptions="Center"
    VerticalOptions="Center"
    Padding="0"
       x:Name="saveButton"                 Margin="10,0,0,10"
    />
                        <Button Text="Close"
    BackgroundColor="#9E9E9E"
    TextColor="White"
    FontSize="16"
    WidthRequest="100"
    HeightRequest="40"
    CornerRadius="20"
    FontAttributes="Bold"
    ToolTipProperties.Text="Close"
    Clicked="OnCloseClicked"
    HorizontalOptions="Center"
    VerticalOptions="Center"
    Padding="0"
                        Margin="10,0,0,10"
    />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
            <Grid            
 BackgroundColor="#80000000"
 IsVisible="False"
 x:Name="loadingGrid"
 InputTransparent="False">
                <!-- This blocks interaction -->

                <ActivityIndicator 
         x:Name="loadingSpinner"
     IsRunning="False" 
     HorizontalOptions="Center" 
     VerticalOptions="Center"
     Color="White" 
     WidthRequest="50"
     HeightRequest="50"/>
            </Grid>
        </Grid>
       
    </ScrollView>
</toolkit:Popup>
